# Copy this file to .env and add your key. Without a key the app runs in demo mode.
# Any OpenAI-compatible Chat Completions API works.

# Google Gemini (default) - key from https://aistudio.google.com/apikey
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.6-flash

# Local open-source model with Ollama (no key needed, any non-empty value works):
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2
